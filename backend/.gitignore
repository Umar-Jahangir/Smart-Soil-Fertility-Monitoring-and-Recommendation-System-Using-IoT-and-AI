# ==============================
# Smart Farm Project - .gitignore
# ==============================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Python packaging
*.egg-info/
dist/
build/

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- FastAPI / Uvicorn ----------
*.log

# ---------- VS Code ----------
.vscode/
*.code-workspace

# ---------- IntelliJ / PyCharm ----------
.idea/

# ---------- Windows ----------
Thumbs.db
desktop.ini

# ---------- macOS ----------
.DS_Store

# ---------- Arduino ----------
# Arduino IDE generated files
*.hex
*.elf
*.bin
*.eep
*.map

# Arduino build/cache directories
arduino_build/
arduino_cache/

# ---------- ESP32 ----------
# Compiled firmware/build artifacts
*.uf2

# ---------- Node / Frontend ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Temporary files ----------
*.tmp
*.temp
*.swp
*.swo

# ---------- OS/editor backup files ----------
*~
*.bak
*.backup